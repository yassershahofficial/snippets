# Shared / local defaults — copy to .env and adjust

# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=mongodb://mongo:27017/snippets
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
CSRF_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Astro → Payload (use http://cms:3000 inside Compose; localhost when web runs on host)
PAYLOAD_URL=http://localhost:3000
# Browser-facing Payload origin for media/OG image URLs
PUBLIC_PAYLOAD_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:4321
