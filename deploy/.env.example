# Copy to `.env` on the VPS and fill in real values.
# Never commit the real `.env`.

# --- GHCR images (set OWNER/REPO to match GitHub; tag from CI or :latest) ---
CMS_IMAGE=ghcr.io/OWNER/REPO/snippets-cms:latest
WEB_IMAGE=ghcr.io/OWNER/REPO/snippets-web:latest

# Host loopback ports (change if another project already uses 3000/4321)
CMS_HOST_PORT=3000
WEB_HOST_PORT=4321

# --- Public URLs (must match DNS + Caddy) ---
# Example: site https://snippets.example.com  admin https://cms.snippets.example.com
PUBLIC_SITE_URL=https://snippets.example.com
PAYLOAD_PUBLIC_SERVER_URL=https://cms.snippets.example.com
PUBLIC_PAYLOAD_URL=https://cms.snippets.example.com

# Comma-separated origins allowed to talk to Payload (site origin)
CORS_ORIGINS=https://snippets.example.com
CSRF_ORIGINS=https://snippets.example.com

# Long random string (e.g. openssl rand -hex 32)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional: used only by compose Caddyfile placeholders via envsubst if you template it.
# Default Caddyfile uses literal hostnames — edit Caddyfile to match the URLs above.
SITE_HOST=snippets.example.com
CMS_HOST=cms.snippets.example.com
