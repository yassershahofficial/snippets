---
import { absolutizeMediaUrl } from '../../lib/lexical'
import type { Author, Badge, Media, Post, Tag } from '../../lib/payload'
import { youtubeEmbedUrl } from '../../lib/youtube'

interface Props {
  post: Post
  authors: Author[]
  tags: Tag[]
  badges: Badge[]
  bodyHtml: string
}

const { post, authors, tags, badges, bodyHtml } = Astro.props

const heroType = post.heroMedia?.type
const youtubeEmbed =
  heroType === 'youtube' ? youtubeEmbedUrl(post.heroMedia?.youtubeUrl) : null
const heroImage =
  heroType === 'image' && post.heroMedia?.image && typeof post.heroMedia.image === 'object'
    ? (post.heroMedia.image as Media)
    : null
const heroImageUrl = absolutizeMediaUrl(heroImage?.url)
const showHero = Boolean(youtubeEmbed || heroImageUrl)

const ctaLinks = (post.ctaLinks ?? []).filter((link) => link?.label && link?.url)

const badgeCount = badges.length
const badgeScale =
  badgeCount <= 4 ? 'lg' : badgeCount <= 8 ? 'md' : 'sm'
const badgeListClass =
  badgeScale === 'lg'
    ? 'mb-10 flex flex-wrap items-center gap-x-6 gap-y-5'
    : badgeScale === 'md'
      ? 'mb-10 flex flex-wrap items-center gap-x-5 gap-y-4'
      : 'mb-10 flex flex-wrap items-center gap-x-3 gap-y-3'
const badgeLogoClass =
  badgeScale === 'lg'
    ? 'h-10 w-10 object-contain'
    : badgeScale === 'md'
      ? 'h-8 w-8 object-contain'
      : 'h-5 w-5 object-contain'
const badgeLogoSize = badgeScale === 'lg' ? 40 : badgeScale === 'md' ? 32 : 20
const badgeNameClass =
  badgeScale === 'lg'
    ? 'text-base text-[var(--page-fg)]'
    : badgeScale === 'md'
      ? 'text-sm text-[var(--page-fg)]'
      : 'text-xs text-[var(--page-fg)]'
const badgeItemClass =
  badgeScale === 'lg'
    ? 'inline-flex items-center gap-3'
    : badgeScale === 'md'
      ? 'inline-flex items-center gap-2'
      : 'inline-flex items-center gap-1.5'
---

<article>
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--page-muted)]">
      Showcase
    </p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance">{post.title}</h1>
    <p class="mt-4 text-sm text-[var(--page-muted)]">
      {
        post.publishedAt
          ? new Date(post.publishedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          : ''
      }
      {post.readingTime ? ` · ${post.readingTime} min read` : ''}
    </p>
    {
      authors.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {authors.map((author) => (
            <li>
              <a href={`/authors/${author.slug}`}>{author.name}</a>
            </li>
          ))}
        </ul>
      )
    }
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-[var(--page-muted)]">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag.slug}`} class="no-underline hover:text-[var(--page-accent)]">
                #{tag.name}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  {
    showHero && (
      <section class="mb-8" aria-label="Project media">
        {youtubeEmbed ? (
          <div class="aspect-video w-full overflow-hidden border border-[var(--page-border)] bg-[var(--page-code-bg)]">
            <iframe
              src={youtubeEmbed}
              title={`${post.title} walkthrough`}
              class="h-full w-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        ) : (
          heroImageUrl && (
            <figure class="prose-figure m-0">
              <img
                src={heroImageUrl}
                alt={heroImage?.alt || `${post.title} preview`}
                width={heroImage?.width ?? undefined}
                height={heroImage?.height ?? undefined}
                loading="eager"
                decoding="async"
                class="w-full"
              />
            </figure>
          )
        )}
      </section>
    )
  }

  {
    ctaLinks.length > 0 && (
      <nav class="mb-8 flex flex-wrap gap-3" aria-label="Project links">
        {ctaLinks.map((link, index) => (
          <a
            href={link.url}
            class={`cta-btn ${index === 0 ? 'cta-btn--solid' : 'cta-btn--outline'}`}
            rel="noopener noreferrer"
            target="_blank"
          >
            {link.label}
          </a>
        ))}
      </nav>
    )
  }

  {
    badges.length > 0 && (
      <ul class={badgeListClass} aria-label="Tech stack">
        {badges.map((badge) => {
          const logo = typeof badge.logo === 'object' && badge.logo ? badge.logo : null
          const logoUrl = absolutizeMediaUrl(logo?.url)
          return (
            <li>
              {badge.website ? (
                <a
                  href={badge.website}
                  class={`${badgeItemClass} no-underline hover:opacity-80`}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {logoUrl && (
                    <img
                      src={logoUrl}
                      alt=""
                      width={badgeLogoSize}
                      height={badgeLogoSize}
                      class={badgeLogoClass}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span class={badgeNameClass}>{badge.name}</span>
                </a>
              ) : (
                <span class={badgeItemClass}>
                  {logoUrl && (
                    <img
                      src={logoUrl}
                      alt=""
                      width={badgeLogoSize}
                      height={badgeLogoSize}
                      class={badgeLogoClass}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <span class={badgeNameClass}>{badge.name}</span>
                </span>
              )}
            </li>
          )
        })}
      </ul>
    )
  }

  <div class="prose-body max-w-[65ch]" set:html={bodyHtml} />
</article>
