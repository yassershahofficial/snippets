---
import type { Author, Post, Tag } from '../../lib/payload'
import type { TocItem } from '../../lib/lexical'
import CopyCodeEnhancer from './CopyCodeEnhancer.astro'

interface Props {
  post: Post
  authors: Author[]
  tags: Tag[]
  toc: TocItem[]
  bodyHtml: string
}

const { post, authors, tags, toc, bodyHtml } = Astro.props
---

<article>
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--page-muted)]">
      Snippet
    </p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance">{post.title}</h1>
    {
      post.summary && (
        <p class="mt-4 text-lg text-[var(--page-muted)] text-pretty">{post.summary}</p>
      )
    }
    <p class="mt-4 text-sm text-[var(--page-muted)]">
      {
        post.publishedAt
          ? new Date(post.publishedAt).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          : ''
      }
      {post.readingTime ? ` · ${post.readingTime} min read` : ''}
    </p>
    {
      authors.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {authors.map((author) => (
            <li>
              <a href={`/authors/${author.slug}`}>{author.name}</a>
            </li>
          ))}
        </ul>
      )
    }
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-[var(--page-muted)]">
          {tags.map((tag) => (
            <li>
              <a href={`/tags/${tag.slug}`} class="no-underline hover:text-[var(--page-accent)]">
                #{tag.name}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  <div class="snippet-layout">
    {
      toc.length > 0 && (
        <nav class="snippet-toc" aria-label="Table of contents">
          <p class="snippet-toc__label">On this page</p>
          <ol class="snippet-toc__list">
            {toc.map((item) => (
              <li class={item.depth === 3 ? 'snippet-toc__item snippet-toc__item--h3' : 'snippet-toc__item'}>
                <a href={`#${item.id}`} class="snippet-toc__link">
                  {item.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="snippet-body prose-body" set:html={bodyHtml} />
  </div>
</article>

<CopyCodeEnhancer />
