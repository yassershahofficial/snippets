---
export const prerender = false

import EssayPost from '../../components/posts/EssayPost.astro'
import ShowcasePost from '../../components/posts/ShowcasePost.astro'
import SnippetPost from '../../components/posts/SnippetPost.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { buildEssayJsonLd, buildShowcaseJsonLd, buildSnippetJsonLd, jsonLdScriptContent } from '../../lib/jsonld'
import { absolutizeMediaUrl, excerptText, extractTocFromLexical, lexicalToHtml, lexicalToPlainText } from '../../lib/lexical'
import { getPostBySlug, type Author, type Badge, type Media, type Post, type Tag } from '../../lib/payload'

const { slug } = Astro.params
if (!slug) {
  return Astro.redirect('/')
}

let post: Post | null = null
try {
  post = await getPostBySlug(slug)
} catch {
  post = null
}

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const authors = (post.authors ?? []).filter((a): a is Author => typeof a === 'object' && a !== null)
const tags = (post.tags ?? []).filter((t): t is Tag => typeof t === 'object' && t !== null)
const badges = (post.badges ?? []).filter((b): b is Badge => typeof b === 'object' && b !== null)

const isSnippet = post.layout === 'snippet'
const bodyHtml = lexicalToHtml(post.body, { codeCopyable: isSnippet })
const toc = isSnippet ? extractTocFromLexical(post.body) : []

const pageTitle = post.seo?.metaTitle || post.title
const pageDescription =
  post.seo?.metaDescription ||
  post.summary ||
  excerptText(lexicalToPlainText(post.body)) ||
  undefined

const ogImage =
  post.seo?.ogImage && typeof post.seo.ogImage === 'object'
    ? (post.seo.ogImage as Media)
    : null
const ogImageUrl = absolutizeMediaUrl(ogImage?.url)
const ogImageAlt = ogImage?.alt || undefined

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321').replace(/\/$/, '')
const pageUrl = post.seo?.canonical || new URL(Astro.url.pathname, `${siteUrl}/`).href

const jsonLd =
  post.layout === 'essay'
    ? jsonLdScriptContent(
        buildEssayJsonLd({
          post,
          authors,
          tags,
          pageUrl,
          description: pageDescription,
          imageUrl: ogImageUrl || undefined,
        }),
      )
    : post.layout === 'showcase'
      ? jsonLdScriptContent(
          buildShowcaseJsonLd({
            post,
            authors,
            badges,
            pageUrl,
            description: pageDescription,
          }),
        )
      : post.layout === 'snippet'
        ? jsonLdScriptContent(
            buildSnippetJsonLd({
              post,
              authors,
              pageUrl,
              description: pageDescription,
            }),
          )
        : undefined

const layoutWidth =
  post.layout === 'showcase' ? 'showcase' : post.layout === 'snippet' ? 'snippet' : 'reading'
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  width={layoutWidth}
  ogImageUrl={ogImageUrl || undefined}
  ogImageAlt={ogImageAlt}
  canonical={post.seo?.canonical || undefined}
  noIndex={Boolean(post.seo?.noIndex)}
  jsonLd={jsonLd}
>
  {
    post.layout === 'essay' ? (
      <EssayPost
        post={post}
        authors={authors}
        tags={tags}
        bodyHtml={bodyHtml}
        ogImageUrl={ogImageUrl}
        ogImageAlt={ogImageAlt}
        ogImage={ogImage}
      />
    ) : post.layout === 'showcase' ? (
      <ShowcasePost post={post} authors={authors} tags={tags} badges={badges} bodyHtml={bodyHtml} />
    ) : post.layout === 'snippet' ? (
      <SnippetPost post={post} authors={authors} tags={tags} toc={toc} bodyHtml={bodyHtml} />
    ) : (
      <article>
        <h1 class="text-4xl font-semibold tracking-tight">{post.title}</h1>
        <p class="mt-6 border border-[var(--page-border)] bg-[var(--page-code-bg)] px-4 py-3 text-sm text-[var(--page-muted)]">
          Unknown layout <code class="font-mono">{post.layout}</code>.
        </p>
      </article>
    )
  }
</BaseLayout>
