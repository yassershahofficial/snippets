---
export const prerender = false

import BaseLayout from '../../layouts/BaseLayout.astro'
import { getPostsByTag, getTagBySlug, type Post, type Tag } from '../../lib/payload'

const { slug } = Astro.params
if (!slug) {
  return Astro.redirect('/')
}

let tag: Tag | null = null
let posts: Post[] = []

try {
  tag = await getTagBySlug(slug)
  if (tag) {
    posts = await getPostsByTag(tag.id)
  }
} catch {
  tag = null
}

if (!tag) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

function formatDate(iso?: string | null): string {
  if (!iso) return ''
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<BaseLayout title={`#${tag.name} · SNIPPETS`} width="home">
  <article>
    <header class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--page-muted)]">Tag</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight">#{tag.name}</h1>
      {tag.description && (
        <p class="mt-4 max-w-[65ch] text-[var(--page-muted)] leading-relaxed">{tag.description}</p>
      )}
    </header>

    <h2 class="text-2xl font-semibold tracking-tight">Posts</h2>
    {posts.length === 0 ? (
      <p class="mt-4 text-[var(--page-muted)]">No published posts with this tag yet.</p>
    ) : (
      <ul class="mt-4 border-t border-[var(--page-border)]">
        {posts.map((post) => (
          <li class="border-b border-[var(--page-border)] py-5">
            <a
              href={`/posts/${post.slug}`}
              class="text-xl font-semibold text-[var(--page-fg)] no-underline hover:text-[var(--page-accent)]"
            >
              {post.title}
            </a>
            <p class="mt-1 text-sm text-[var(--page-muted)]">
              {[formatDate(post.publishedAt), post.readingTime ? `${post.readingTime} min read` : '']
                .filter(Boolean)
                .join(' · ')}
            </p>
          </li>
        ))}
      </ul>
    )}
  </article>
</BaseLayout>
